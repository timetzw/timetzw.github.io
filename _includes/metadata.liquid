{% capture author_name %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
{% assign description = page.description | default: site.description | strip %}
{% capture page_title %}{% if page.seo_title %}{{ page.seo_title }}{% elsif page.url == '/' %}{{ author_name }}{% else %}{{ page.title }} | {{ author_name }}{% endif %}{% endcapture %}
{% assign canonical_url = page.url | replace: 'index.html', '' | absolute_url %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title | strip | escape }}</title>
<meta name="author" content="{{ author_name | escape }}">
<meta name="description" content="{{ description | escape }}">
{% if page.noindex %}<meta name="robots" content="noindex, follow">{% endif %}
{% if site.enable_google_verification and site.google_site_verification -%}
  <meta name="google-site-verification" content="{{ site.google_site_verification | escape }}">
{%- endif %}
{% if site.enable_bing_verification and site.bing_site_verification -%}
  <meta name="msvalidate.01" content="{{ site.bing_site_verification | escape }}">
{%- endif %}
{% if site.serve_og_meta %}
  <meta property="og:site_name" content="Zhengwei Tong">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | strip | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ description | escape }}">
  <meta property="og:image" content="{{ site.og_image | absolute_url }}">
  <meta property="og:image:alt" content="Portrait of Zhengwei Tong">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ page_title | strip | escape }}">
  <meta name="twitter:description" content="{{ description | escape }}">
  <meta name="twitter:image" content="{{ site.og_image | absolute_url }}">
  <meta name="twitter:creator" content="@{{ site.data.socials.x_username }}">
{% endif %}
{% if site.serve_schema_org %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "{{ '/' | absolute_url }}#person",
          "name": {{ author_name | strip | jsonify }},
          "url": {{ '/' | absolute_url | jsonify }},
          "image": {{ site.og_image | jsonify }},
          "jobTitle": "Computer Science PhD Candidate",
          "affiliation": {"@type": "CollegeOrUniversity", "name": "Duke University", "url": "https://duke.edu/"},
          "alumniOf": [{"@type": "CollegeOrUniversity", "name": "University of Wisconsin–Madison"}, {"@type": "CollegeOrUniversity", "name": "Shanghai Jiao Tong University"}],
          "knowsAbout": ["Applied cryptography", "Decentralized systems", "Economic security"],
          "sameAs": ["https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}", "https://orcid.org/{{ site.data.socials.orcid_id }}", "https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}", "https://x.com/{{ site.data.socials.x_username }}"]
        },
        {
          "@type": "WebSite",
          "@id": "{{ '/' | absolute_url }}#website",
          "name": "Zhengwei Tong",
          "url": {{ '/' | absolute_url | jsonify }},
          "publisher": {"@id": "{{ '/' | absolute_url }}#person"}
        },
        {
          "@type": "{% if page.url == '/' %}ProfilePage{% else %}WebPage{% endif %}",
          "@id": {{ canonical_url | jsonify }},
          "name": {{ page_title | strip | jsonify }},
          "url": {{ canonical_url | jsonify }},
          "description": {{ description | jsonify }},
          "isPartOf": {"@id": "{{ '/' | absolute_url }}#website"},
          "{% if page.url == '/' %}mainEntity{% else %}about{% endif %}": {"@id": "{{ '/' | absolute_url }}#person"}
        }
      ]
    }
  </script>
{% endif %}
