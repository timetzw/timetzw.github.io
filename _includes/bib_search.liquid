{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="publication-filter">
    <label for="bibsearch">Filter publications</label>
    <div class="filter-controls">
      <input
        type="search"
        id="bibsearch"
        spellcheck="false"
        autocomplete="off"
        class="search bibsearch-form-input"
        placeholder="Title, author, venue, or topic"
        aria-describedby="filter-status"

      ><button type="button" id="clear-filter">Clear</button>
    </div>
    <p id="filter-status" role="status" aria-live="polite"></p>
  </div>
{% endif %}
