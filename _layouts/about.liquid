---
layout: default
---
<div class="post about-page">
  <div class="post-header">
    <h1 class="post-title">Zhengwei Tong</h1>
    <p class="desc">{{ page.subtitle }}</p>
  </div>
  <p class="primary-links">
    <a href="mailto:{{ site.data.socials.email }}">Email</a
    ><a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a
    ><a href="{{ '/research/' | relative_url }}">All publications</a>
  </p>
  <article>
    <div class="intro">
      <div class="profile">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid rounded" sizes="(max-width: 575px) 120px, 220px" alt=page.profile.alt cache_bust=true %}
      </div>
      <div class="intro-copy">
        {{ content }}
      </div>
    </div>
    <section aria-labelledby="selected-research">
      <h2 id="selected-research">Selected Research</h2>
      {% include selected_papers.liquid %}
      <p><a href="{{ '/research/' | relative_url }}">View all publications →</a></p>
    </section>
    <section aria-labelledby="recent-news">
      <h2 id="recent-news">Recent News</h2>
      {% include news.liquid limit=true %}
      <p><a href="{{ '/news/' | relative_url }}">All news →</a></p>
    </section>
    <section aria-labelledby="teaching">
      <h2 id="teaching">Teaching</h2>
      <ul class="teaching-list">
        {% for course in page.teaching_experience %}
          <li>{{ course | markdownify | remove: '<p>' | remove: '</p>' }}</li>
        {% endfor %}
      </ul>
    </section>
    <div class="social">
      <div class="contact-icons">{% include social.liquid %}</div>
    </div>
  </article>
</div>
